# Normalise line endings in the repository. Without this, a Windows checkout
# can turn every text file into a diff of line endings, which buries real
# changes and breaks patch review.
* text=auto eol=lf

# Windows-only scripts keep CRLF when they ever appear.
*.bat text eol=crlf
*.cmd text eol=crlf
*.ps1 text eol=crlf

# Binary assets must never be converted or diffed as text.
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.webp binary
*.zip binary
*.woff binary
*.woff2 binary

# Brand icons are generated by scripts/generate_brand_icon.py, so a binary
# diff would be noise. Replace them by rerunning the script instead.
brand/*.png binary
custom_components/pv_manager/brand/*.png binary

# Keep these reviewable in every editor.
*.md text
*.json text
*.yaml text
*.yml text
